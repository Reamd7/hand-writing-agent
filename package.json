{
  "name": "my-agent-monorepo",
  "private": true,
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "postinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "lint": "pnpm -r lint && oxlint .",
    "fmt": "pnpm -r fmt && oxfmt format .",
    "fmt:check": "pnpm -r fmt:check && oxfmt check .",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm -r check"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx}": [
      "oxfmt format",
      "oxlint"
    ]
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.4"
}
